generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Utilizadores (professores) ----------

enum Role {
  PROFESSOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(PROFESSOR)
  createdAt    DateTime @default(now())

  turmas Turma[]
  alunos Aluno[]
}

// ---------- Estrutura académica ----------

// Catálogo global de disciplinas, partilhado por todos os utilizadores
// (não pertence a nenhum professor). Só ADMIN pode criar/editar/apagar
// (ver requireAdminId em src/lib/auth.ts); qualquer professor pode
// associá-las às suas turmas.
model Disciplina {
  id                 String   @id @default(cuid())
  nome               String
  grupoDisciplinarId String? // nullable: disciplinas antigas podem não ter grupo atribuído
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  grupoDisciplinar GrupoDisciplinar?           @relation(fields: [grupoDisciplinarId], references: [id])
  ciclos           DisciplinaCiclo[]
  anosEscolaridade DisciplinaAnoEscolaridade[]
  turmaDisciplinas TurmaDisciplina[]
  instrumentoPesos InstrumentoPeso[]

  @@unique([nome])
}

// Catálogo global de grupos disciplinares (ex.: Línguas, Matemática e
// Ciências). Só ADMIN pode criar (mesmo padrão de Disciplina).
model GrupoDisciplinar {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disciplinas Disciplina[]

  @@unique([nome])
}

// Catálogo global de ciclos de ensino (ex.: 2.º ciclo, 3.º ciclo, Secundário).
model Ciclo {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disciplinas DisciplinaCiclo[]

  @@unique([nome])
}

// Catálogo global de anos de escolaridade (ex.: 7.º ano .. 12.º ano).
model AnoEscolaridade {
  id        String   @id @default(cuid())
  nome      String
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disciplinas DisciplinaAnoEscolaridade[]

  @@unique([nome])
}

model DisciplinaCiclo {
  id           String @id @default(cuid())
  disciplinaId String
  cicloId      String

  disciplina Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  ciclo      Ciclo      @relation(fields: [cicloId], references: [id], onDelete: Cascade)

  @@unique([disciplinaId, cicloId])
}

model DisciplinaAnoEscolaridade {
  id                String @id @default(cuid())
  disciplinaId      String
  anoEscolaridadeId String

  disciplina      Disciplina      @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  anoEscolaridade AnoEscolaridade @relation(fields: [anoEscolaridadeId], references: [id], onDelete: Cascade)

  @@unique([disciplinaId, anoEscolaridadeId])
}

// Catálogo global de anos letivos, partilhado por todos os utilizadores.
// Só ADMIN pode criar/editar/apagar.
model AnoLetivo {
  id   String @id @default(cuid())
  nome String // ex: "2025/2026"

  turmas          Turma[]
  gruposAvaliacao GrupoAvaliacao[]

  @@unique([nome])
}

// ---------- Critérios de avaliação (configuração global por ano letivo) ----------

// Catálogo global de critérios de avaliação (grupos/instrumentos), não
// associado a nenhum utilizador. Só ADMIN pode criar/editar/apagar.
model GrupoAvaliacao {
  id          String @id @default(cuid())
  anoLetivoId String
  nome        String // ex: "Atitudes", "Conhecimentos e Capacidades"
  ordem       Int    @default(0)

  anoLetivo    AnoLetivo              @relation(fields: [anoLetivoId], references: [id], onDelete: Cascade)
  instrumentos InstrumentoAvaliacao[]

  @@unique([anoLetivoId, nome])
}

model InstrumentoAvaliacao {
  id      String @id @default(cuid())
  grupoId String
  nome    String // ex: "Testes", "Trabalhos de grupo"
  ordem   Int    @default(0)

  grupo                       GrupoAvaliacao                @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  pesos                       InstrumentoPeso[]
  turmaDisciplinaInstrumentos TurmaDisciplinaInstrumento[]

  @@unique([grupoId, nome])
}

// Ativação de um InstrumentoAvaliacao do catálogo global numa TurmaDisciplina
// concreta, com o peso efetivamente usado nessa turma (copiado do catálogo
// no momento da ativação, mas editável depois sem afetar o catálogo nem
// outras turmas). Substitui o antigo modelo `Criterio`, que duplicava
// nome/grupo em vez de reutilizar o catálogo.
model TurmaDisciplinaInstrumento {
  id                      String @id @default(cuid())
  turmaDisciplinaId       String
  instrumentoAvaliacaoId  String
  peso                    Float // 0 a 1, específico desta turma+disciplina
  ordem                   Int

  turmaDisciplina      TurmaDisciplina      @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)
  instrumentoAvaliacao InstrumentoAvaliacao @relation(fields: [instrumentoAvaliacaoId], references: [id], onDelete: Cascade)
  instrumentos         Instrumento[]

  @@unique([turmaDisciplinaId, instrumentoAvaliacaoId])
}

// Peso do instrumento numa disciplina concreta — o mesmo instrumento pode
// estar ativo em várias disciplinas, cada uma com o seu próprio peso.
model InstrumentoPeso {
  id            String @id @default(cuid())
  instrumentoId String
  disciplinaId  String
  peso          Float // 0 a 1

  instrumento InstrumentoAvaliacao @relation(fields: [instrumentoId], references: [id], onDelete: Cascade)
  disciplina  Disciplina           @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)

  @@unique([instrumentoId, disciplinaId])
}

// Turma = grupo de alunos (ex.: "9.º F"). Não está ligada a nenhuma
// disciplina diretamente — as disciplinas que a turma leciona são geridas
// em TurmaDisciplina, e a inscrição de cada aluno em cada disciplina é
// individual (ver AlunoDisciplina).
model Turma {
  id          String @id @default(cuid())
  userId      String
  anoLetivoId String
  nome        String // ex: "9.º F"
  nivelEnsino String? // ex: "3.º ciclo"
  createdAt   DateTime @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  anoLetivo   AnoLetivo         @relation(fields: [anoLetivoId], references: [id], onDelete: Cascade)
  matriculas  Matricula[]
  periodos    Periodo[]
  disciplinas TurmaDisciplina[]

  @@unique([userId, anoLetivoId, nome])
}

// Disciplina oferecida por uma turma (catálogo global de Disciplina,
// associado a uma Turma concreta). A mesma Disciplina pode estar associada
// a várias Turmas sem duplicar o registo de Disciplina; a mesma Turma não
// pode ter a mesma Disciplina associada duas vezes (@@unique abaixo).
// Os critérios/instrumentos de avaliação e os limiares de nível vivem aqui,
// porque dependem da disciplina, não só da turma.
model TurmaDisciplina {
  id           String @id @default(cuid())
  turmaId      String
  disciplinaId String

  // Limiares de nível (percentagem 0-100), configuráveis por disciplina da turma
  limiarNivel2 Float @default(20)
  limiarNivel3 Float @default(50)
  limiarNivel4 Float @default(70)
  limiarNivel5 Float @default(90)

  turma        Turma                        @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  disciplina   Disciplina                   @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  criterios    TurmaDisciplinaInstrumento[]
  instrumentos Instrumento[]
  alunos       AlunoDisciplina[]

  @@unique([turmaId, disciplinaId])
}

model Aluno {
  id             String  @id @default(cuid())
  userId         String
  numeroProcesso String // identidade fixa do aluno, não muda ao transferir de turma
  nome           String
  ativo          Boolean @default(true)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  matriculas  Matricula[]
  notas       Nota[]
  disciplinas AlunoDisciplina[]
  medidas     AlunoMedida[]

  @@unique([userId, numeroProcesso])
}

// Histórico de inscrição do aluno numa turma. Transferir fecha a
// matrícula atual (ativa=false, terminadaEm preenchido) e cria uma nova —
// mantém o histórico de por onde o aluno passou, sem apagar nada.
model Matricula {
  id          String    @id @default(cuid())
  alunoId     String
  turmaId     String
  numero      Int // nº de turma nesta matrícula
  ativa       Boolean   @default(true)
  criadaEm    DateTime  @default(now())
  terminadaEm DateTime?

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([turmaId, numero])
}

// ---------- Medidas de suporte à aprendizagem (Dec-Lei 54/2018) ----------

enum TipoMedida {
  UNIVERSAL
  SELETIVA
  ADICIONAL
}

// Catálogo fixo (definido por lei), semeado na migração — sem UI de gestão.
model Medida {
  id     String     @id @default(cuid())
  tipo   TipoMedida
  codigo String // "a".."e"
  titulo String

  alunos AlunoMedida[]

  @@unique([tipo, codigo])
}

// Medidas atribuídas a um aluno (0 ou mais)
model AlunoMedida {
  id       String @id @default(cuid())
  alunoId  String
  medidaId String

  aluno  Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  medida Medida @relation(fields: [medidaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, medidaId])
}

// Inscrição individual do aluno numa disciplina da turma. Liga-se a
// TurmaDisciplina (não a Disciplina diretamente), o que garante que um
// aluno só se pode inscrever numa disciplina que a sua turma efetivamente
// oferece. `ativo=false` fecha a inscrição (saída/mudança) sem apagar
// histórico — permite reabrir mais tarde sem violar o @@unique.
model AlunoDisciplina {
  id                String  @id @default(cuid())
  alunoId           String
  turmaDisciplinaId String
  ativo             Boolean @default(true)
  criadoEm          DateTime @default(now())

  aluno           Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turmaDisciplina TurmaDisciplina @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, turmaDisciplinaId])
}

model Periodo {
  id      String @id @default(cuid())
  turmaId String
  nome    String // ex: "1.º Semestre"
  ordem   Int

  turma        Turma         @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  instrumentos Instrumento[]

  @@unique([turmaId, ordem])
}

// ---------- Critérios de avaliação (pesos configuráveis) ----------

enum ModoAvaliacao {
  PONTOS // soma de pontos obtidos / soma de pontos máximos
  ESCALA // média de valores numa escala (ex.: 1 a 5)
}

// ---------- Instrumentos de avaliação ----------

model Instrumento {
  id                String        @id @default(cuid())
  turmaDisciplinaId String
  periodoId         String
  criterioId        String
  nome              String // ex: "Teste de Avaliação 1", "Responsabilidade e valores..."
  modo              ModoAvaliacao @default(PONTOS)
  escalaMax         Int           @default(5) // usado quando modo = ESCALA
  unidade           String?
  tema              String?
  data              DateTime?
  ordem             Int           @default(0)

  turmaDisciplina TurmaDisciplina            @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)
  periodo         Periodo                    @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  criterio        TurmaDisciplinaInstrumento @relation(fields: [criterioId], references: [id], onDelete: Cascade)
  perguntas       Pergunta[]

  @@index([turmaDisciplinaId, periodoId])
}

model Pergunta {
  id            String  @id @default(cuid())
  instrumentoId String
  codigo        String // ex: "2.1.", "Responsabilidade"
  valorMax      Float // pontos máximos (modo=PONTOS) ou escala máxima (modo=ESCALA)
  ordem         Int

  instrumento Instrumento @relation(fields: [instrumentoId], references: [id], onDelete: Cascade)
  notas       Nota[]

  @@index([instrumentoId])
}

model Nota {
  id         String @id @default(cuid())
  perguntaId String
  alunoId    String
  valor      Float?

  pergunta Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  aluno    Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([perguntaId, alunoId])
  @@index([alunoId])
}
