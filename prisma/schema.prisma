generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Utilizadores (professores) ----------

enum Role {
  PROFESSOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(PROFESSOR)
  createdAt    DateTime @default(now())

  turmas          Turma[]
}

// ---------- Estrutura académica ----------

// Catálogo global de disciplinas, partilhado por todos os utilizadores
// (não pertence a nenhum professor). Só ADMIN pode criar/editar/apagar
// (ver requireAdminId em src/lib/auth.ts); qualquer professor pode
// associá-las às suas turmas.
model Disciplina {
  id    String  @id @default(cuid())
  nome  String
  ciclo String? // ex: "2.º ciclo", "3.º ciclo", "Secundário"

  turmaDisciplinas TurmaDisciplina[]
  instrumentoPesos InstrumentoPeso[]

  @@unique([nome])
}

// Catálogo global de anos letivos, partilhado por todos os utilizadores.
// Só ADMIN pode criar/editar/apagar.
model AnoLetivo {
  id   String @id @default(cuid())
  nome String // ex: "2025/2026"

  turmas          Turma[]
  gruposAvaliacao GrupoAvaliacao[]

  @@unique([nome])
}

// ---------- Critérios de avaliação (configuração global por ano letivo) ----------

// Catálogo global de critérios de avaliação (grupos/instrumentos), não
// associado a nenhum utilizador. Só ADMIN pode criar/editar/apagar.
model GrupoAvaliacao {
  id          String @id @default(cuid())
  anoLetivoId String
  nome        String // ex: "Atitudes", "Conhecimentos e Capacidades"
  ordem       Int    @default(0)

  anoLetivo    AnoLetivo              @relation(fields: [anoLetivoId], references: [id], onDelete: Cascade)
  instrumentos InstrumentoAvaliacao[]

  @@unique([anoLetivoId, nome])
}

model InstrumentoAvaliacao {
  id      String @id @default(cuid())
  grupoId String
  nome    String // ex: "Testes", "Trabalhos de grupo"
  ordem   Int    @default(0)

  grupo GrupoAvaliacao    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  pesos InstrumentoPeso[]

  @@unique([grupoId, nome])
}

// Peso do instrumento numa disciplina concreta — o mesmo instrumento pode
// estar ativo em várias disciplinas, cada uma com o seu próprio peso.
model InstrumentoPeso {
  id            String @id @default(cuid())
  instrumentoId String
  disciplinaId  String
  peso          Float // 0 a 1

  instrumento InstrumentoAvaliacao @relation(fields: [instrumentoId], references: [id], onDelete: Cascade)
  disciplina  Disciplina           @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)

  @@unique([instrumentoId, disciplinaId])
}

// Turma = grupo de alunos (ex.: "9.º F"). Não está ligada a nenhuma
// disciplina diretamente — as disciplinas que a turma leciona são geridas
// em TurmaDisciplina, e a inscrição de cada aluno em cada disciplina é
// individual (ver AlunoDisciplina).
model Turma {
  id          String @id @default(cuid())
  userId      String
  anoLetivoId String
  nome        String // ex: "9.º F"
  nivelEnsino String? // ex: "3.º ciclo"
  createdAt   DateTime @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  anoLetivo   AnoLetivo         @relation(fields: [anoLetivoId], references: [id], onDelete: Cascade)
  alunos      Aluno[]
  periodos    Periodo[]
  disciplinas TurmaDisciplina[]

  @@unique([userId, anoLetivoId, nome])
}

// Disciplina oferecida por uma turma (catálogo global de Disciplina,
// associado a uma Turma concreta). A mesma Disciplina pode estar associada
// a várias Turmas sem duplicar o registo de Disciplina; a mesma Turma não
// pode ter a mesma Disciplina associada duas vezes (@@unique abaixo).
// Os critérios/instrumentos de avaliação e os limiares de nível vivem aqui,
// porque dependem da disciplina, não só da turma.
model TurmaDisciplina {
  id           String @id @default(cuid())
  turmaId      String
  disciplinaId String

  // Limiares de nível (percentagem 0-100), configuráveis por disciplina da turma
  limiarNivel2 Float @default(20)
  limiarNivel3 Float @default(50)
  limiarNivel4 Float @default(70)
  limiarNivel5 Float @default(90)

  turma        Turma             @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  disciplina   Disciplina        @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  criterios    Criterio[]
  instrumentos Instrumento[]
  alunos       AlunoDisciplina[]

  @@unique([turmaId, disciplinaId])
}

model Aluno {
  id      String  @id @default(cuid())
  turmaId String
  numero  Int
  nome    String
  medidas String? // Dec-Lei 54, ex: "Medidas seletivas;Medidas adicionais"
  aliena  String?
  ativo   Boolean @default(true)

  turma       Turma             @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  notas       Nota[]
  disciplinas AlunoDisciplina[]

  @@unique([turmaId, numero])
}

// Inscrição individual do aluno numa disciplina da turma. Liga-se a
// TurmaDisciplina (não a Disciplina diretamente), o que garante que um
// aluno só se pode inscrever numa disciplina que a sua turma efetivamente
// oferece. `ativo=false` fecha a inscrição (saída/mudança) sem apagar
// histórico — permite reabrir mais tarde sem violar o @@unique.
model AlunoDisciplina {
  id                String  @id @default(cuid())
  alunoId           String
  turmaDisciplinaId String
  ativo             Boolean @default(true)
  criadoEm          DateTime @default(now())

  aluno           Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turmaDisciplina TurmaDisciplina @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, turmaDisciplinaId])
}

model Periodo {
  id      String @id @default(cuid())
  turmaId String
  nome    String // ex: "1.º Semestre"
  ordem   Int

  turma        Turma         @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  instrumentos Instrumento[]

  @@unique([turmaId, ordem])
}

// ---------- Critérios de avaliação (pesos configuráveis) ----------

enum ModoAvaliacao {
  PONTOS // soma de pontos obtidos / soma de pontos máximos
  ESCALA // média de valores numa escala (ex.: 1 a 5)
}

model Criterio {
  id                String @id @default(cuid())
  turmaDisciplinaId String
  grupo             String // ex: "Conhecimentos e Capacidades", "Atitudes"
  nome              String // ex: "Testes de avaliação", "Responsabilidade..."
  peso              Float // 0 a 1 (ex.: 0.45 = 45%)
  ordem             Int

  turmaDisciplina TurmaDisciplina @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)
  instrumentos    Instrumento[]

  @@unique([turmaDisciplinaId, nome])
}

// ---------- Instrumentos de avaliação ----------

model Instrumento {
  id                String        @id @default(cuid())
  turmaDisciplinaId String
  periodoId         String
  criterioId        String
  nome              String // ex: "Teste de Avaliação 1", "Responsabilidade e valores..."
  modo              ModoAvaliacao @default(PONTOS)
  escalaMax         Int           @default(5) // usado quando modo = ESCALA
  unidade           String?
  tema              String?
  data              DateTime?
  ordem             Int           @default(0)

  turmaDisciplina TurmaDisciplina @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)
  periodo         Periodo         @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  criterio        Criterio        @relation(fields: [criterioId], references: [id], onDelete: Cascade)
  perguntas       Pergunta[]

  @@index([turmaDisciplinaId, periodoId])
}

model Pergunta {
  id            String  @id @default(cuid())
  instrumentoId String
  codigo        String // ex: "2.1.", "Responsabilidade"
  valorMax      Float // pontos máximos (modo=PONTOS) ou escala máxima (modo=ESCALA)
  ordem         Int

  instrumento Instrumento @relation(fields: [instrumentoId], references: [id], onDelete: Cascade)
  notas       Nota[]

  @@index([instrumentoId])
}

model Nota {
  id         String @id @default(cuid())
  perguntaId String
  alunoId    String
  valor      Float?

  pergunta Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  aluno    Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([perguntaId, alunoId])
  @@index([alunoId])
}
